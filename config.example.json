{
  "publicUrl": "https://vcm.example.com",
  "listen": { "host": "127.0.0.1", "port": 8787, "allowNonLoopback": false },
  "stateDir": "/var/lib/voice-coding-mcp",
  "projectRoots": ["/home/vcm/projects"],
  "claude": {
    "bin": "claude",
    "model": null,
    "effort": null,
    "maxTurns": null,
    "permissionMode": "auto",
    "settingSources": ["user"],
    "configDir": null,
    "mcpServers": {},
    "extraArgs": [],
    "env": {}
  },
  "tasks": { "syncWaitSeconds": 25, "timeoutMinutes": 15, "maxConcurrent": 2, "maxQueued": 10, "resumeWithinHours": 12, "keepDays": 14 },
  "sessions": { "days": 7, "replyWaitMinutes": 10 },
  "remoteControl": { "maxSessions": 3 },
  "oauth": {
    "accessTokenHours": 24,
    "refreshTokenDays": 90,
    "pairingMinutes": 10,
    "redirectUris": ["https://claude.ai/api/mcp/auth_callback", "https://claude.com/api/mcp/auth_callback"],
    "cimdClientIds": ["https://claude.ai/oauth/mcp-oauth-client-metadata"],
    "allowLoopbackRedirects": false
  },
  "notify": { "url": null, "headers": {}, "includeResult": false },
  "logPrompts": false,
  "remote": {
    "machines": [
      {
        "name": "dev",
        "transport": "ssh",
        "host": "localhost",
        "user": "owner",
        "port": 22,
        "identityFile": "/home/switchboard/.ssh/switchboard_dev",
        "knownHostsFile": "/home/switchboard/.ssh/switchboard_known_hosts",
        "dispatcher": "forced",
        "sessions": ["fpga", "notes", "work-*"],
        "allowUsage": true,
        "allowSend": false,
        "allowPermissionAnswers": false,
        "sendToAnyPane": false
      },
      {
        "name": "buildbox",
        "transport": "ssh",
        "host": "example-host",
        "user": "bot",
        "identityFile": "/home/switchboard/.ssh/switchboard_buildbox",
        "knownHostsFile": "/home/switchboard/.ssh/switchboard_known_hosts",
        "sessions": ["api", "web-*"]
      }
    ],
    "ssh": { "bin": "ssh", "connectTimeoutSeconds": 5, "commandTimeoutSeconds": 10 },
    "captureLines": 60,
    "summary": { "enabled": true, "model": "haiku", "timeoutSeconds": 15 },
    "send": {
      "confirmSeconds": 120,
      "maxChars": 2000,
      "maxPending": 1,
      "minConfirmSeconds": 4,
      "slashCommands": [],
      "riskyPatterns": [],
      "knownTerms": [],
      "clientApproval": false
    }
  },
  "watch": { "intervalSeconds": 0, "longTurnMinutes": 10, "notifyUnreachable": false, "includeQuestion": false },
  "usage": {
    "idleGapMinutes": 15,
    "hourlyRate": 40,
    "currency": "EUR",
    "overlap": "union",
    "maxTranscriptMegabytes": 512,
    "prices": {}
  },
  "timesheet": {
    "timeZone": "Europe/Zurich",
    "clients": { "acme": { "name": "Acme AG" } },
    "projects": {
      "web": { "client": "acme", "aliases": ["web-*"], "repos": ["acme/web"], "paths": [] }
    },
    "authorEmails": ["owner@example.com"],
    "githubLogins": ["owner-login"],
    "roundingMinutes": 0,
    "roundingMode": "nearest",
    "ownerOverlap": "split",
    "recordVoice": true,
    "voiceApproval": true,
    "ghBin": "gh",
    "gitBin": "git",
    "commandTimeoutSeconds": 20
  }
}
